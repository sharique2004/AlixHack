GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# USD per million Gemini input tokens, for usage.estimated_cost_usd (default 0.30)
GEMINI_PRICE_IN_PER_M=0.30
# USD per million Gemini output tokens — thinking tokens bill as output (default 2.50)
GEMINI_PRICE_OUT_PER_M=2.50
# USD per vCPU-hour for the Lean subprocess cost estimate — typical on-demand cloud vCPU (default 0.04)
LEAN_VCPU_PRICE_PER_HOUR=0.04
