{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash deploy/vercel-build.sh",
  "outputDirectory": "demo/frontend/dist",
  "installCommand": "echo skip",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{bin/**,demo/backend/app/**,demo/content/**,SimpleProbate/**,ApiMain.lean}",
      "excludeFiles": "{demo/frontend/**,.lake/**,tools/**,docs/**,deploy/**,demo/backend/.venv/**,**/__pycache__/**,**/node_modules/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!assets/|favicon).*)",
      "destination": "/index.html"
    }
  ]
}
